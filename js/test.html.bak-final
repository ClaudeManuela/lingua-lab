<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>core.js test harness</title>
</head>
<body>
  <h1>core.js test harness</h1>
  <p>Open DevTools → Console. No errors = pass.</p>

<script src="core/core.js"></script>
  <script>
    /* ============================================================
       TEST HARNESS — delete nothing, add tests as you go.
       Each block tests one section of core.js.
       ============================================================ */

    let passed = 0, failed = 0;

    function assert(label, actual, expected) {
      const ok = JSON.stringify(actual) === JSON.stringify(expected);
      if (ok) { passed++; console.log(`✅ ${label}`); }
      else    { failed++; console.error(`❌ ${label}\n   expected:`, expected, '\n   got:     ', actual); }
    }

    function assertTruthy(label, value) {
      if (value) { passed++; console.log(`✅ ${label}`); }
      else       { failed++; console.error(`❌ ${label} — got:`, value); }
    }
    assertTruthy('PALACE_ROOMS defined',       Array.isArray(PALACE_ROOMS) && PALACE_ROOMS.length > 0);
assertTruthy('PALACE_ROOM_MAP built',      PALACE_ROOM_MAP.market);
assertTruthy('SLOT_COLORS defined',        Array.isArray(SLOT_COLORS) && SLOT_COLORS.length > 0);
assertTruthy('PALACE_LANGS defined',       Array.isArray(PALACE_LANGS) && PALACE_LANGS.length > 0);

   assert('escapeHtml escapes <',   escapeHtml('<b>'),   '&lt;b&gt;');
assert('escapeHtml escapes &',   escapeHtml('a & b'), 'a &amp; b');
assert('escapeHtml escapes "',   escapeHtml('"'),     '&quot;');
assertTruthy('LANGUAGES exists',          typeof LANGUAGES === 'object');
assertTruthy('LANGUAGES.spanish exists',  LANGUAGES.spanish);
assertTruthy('THEME_MAP built',           THEME_MAP.time);
assert('normalizeTheme finds label',      normalizeTheme('Time'), 'time');
assert('getLevelIndex A0 Low = 0',        getLevelIndex('A0 Low'), 0);

    /* ---- SECTION 2: fuzzy search ---- */
    assert('levenshtein identical = 0', levenshtein('abc', 'abc'), 0);
    assert('levenshtein one insert = 1', levenshtein('abc', 'abcd'), 1);
    assert('scoreField exact = 0', scoreField('apple', 'apple'), 0);
    assert('scoreField prefix = 1', scoreField('app', 'apple'), 1);
    const many = Array.from({ length: 70 }, (_, i) => ({ word: 'w' + i, reading: '', meaning: '' }));
assert('fuzzySearch caps at 60', fuzzySearch('', many).length, 60);

    const sampleVocab = [
      { word: '사과', reading: 'sagwa', meaning: 'apple' },
      { word: '바나나', reading: 'banana', meaning: 'banana' },
    ];
    assert('fuzzySearch finds apple by meaning',
      fuzzySearch('apple', sampleVocab).length, 1);
    assert('fuzzySearch empty query returns all (≤60)',
      fuzzySearch('', sampleVocab).length, 2);

      const sampleWord = {
  word: 'professoressa', article: 'la', gender: 'fem', number: 'sing',
  forms: [{ text: 'professore', article: 'il', gender: 'masc', number: 'sing' }]
};
assert('formatClusterInline joins base + alt',
  formatClusterInline(sampleWord), '(la) professoressa / (il) professore');
assert('formatClusterShort returns base only',
  formatClusterShort(sampleWord), '(la) professoressa');
    // add one assert per search function

    /* ---- SECTION 3: state + persistence ---- */
    assert('STORAGE_KEY is linguaLab', STORAGE_KEY, 'linguaLab');
assert('ADMIN_KEY_SESSION set',    ADMIN_KEY_SESSION, 'linguaLabAdminKey');
assert('DATA starts null',         DATA, null);
assertTruthy('API_URL set',        typeof API_URL === 'string' && API_URL.startsWith('https://'));

const d = getDefaultData();
assertTruthy('default has dailyLogs',     Array.isArray(d.dailyLogs));
assertTruthy('default has settings',      d.settings);
assert('default study target = 60',       d.settings.koreanStudyTargetHours, 60);
assert('default sessionSize = 25',        d.settings.study.sessionSize, 25);
assert('default has 8 languages',         Object.keys(d.languageLevels).length, 8);
assert('default korean level A0 Low',     d.languageLevels.korean.official, 'A0 Low');

// empty object → gets fully backfilled
const empty = migrateData({});
assertTruthy('migrate fills dailyLogs',        Array.isArray(empty.dailyLogs));
assertTruthy('migrate fills settings',         empty.settings);
assert('migrate fills sessionSize',            empty.settings.study.sessionSize, 25);
assert('migrate fills galleryThemesHidden',    empty.settings.galleryThemesHidden, false);
assertTruthy('migrate fills palaceRooms',      empty.palaceRooms && typeof empty.palaceRooms === 'object');
assertTruthy('migrate builds market room',     empty.palaceRooms.market);
assertTruthy('migrate market has slots',       Array.isArray(empty.palaceRooms.market.slots));

// partial object → old fields preserved, new ones added
const partial = migrateData({ settings: { study: { sessionSize: 10 } } });
assert('migrate preserves sessionSize',        partial.settings.study.sessionSize, 10);
assert('migrate backfills reverseMode',        partial.settings.study.reverseMode, false);

// level migration A0 → A0 Low
const legacyLevel = migrateData({ languageLevels: { korean: { official: 'A0', reading: 'A0', writing: 'A0', listening: 'A0', speaking: 'A0', spelling: 'A0' } } });
assert('migrate upgrades A0 to A0 Low',        legacyLevel.languageLevels.korean.official, 'A0 Low');

// vocab positions get backfilled
const withVocab = migrateData({ vocabulary: [{ word: 'test' }] });
assertTruthy('migrate adds gardenX',           typeof withVocab.vocabulary[0].gardenX === 'number');
assertTruthy('migrate adds childIds',          Array.isArray(withVocab.vocabulary[0].childIds));
assertTruthy('migrate adds plantType',         withVocab.vocabulary[0].plantType);

localStorage.removeItem(STORAGE_KEY);
assert('cache empty → null', getCachedData(), null);

const fake = { metadata: { userName: 'test' } };
cacheData(fake);
assert('cache roundtrip works', getCachedData().metadata.userName, 'test');

// corrupt the cache, confirm it doesn't throw
localStorage.setItem(STORAGE_KEY, '{not json');
assert('cache corrupt → null', getCachedData(), null);

localStorage.removeItem(STORAGE_KEY);  // clean up

clearAdminKey();
assert('no key → null', getAdminKey(), null);

setAdminKey('test-key');
assert('set → get returns', getAdminKey(), 'test-key');
assert('key in sessionStorage', sessionStorage.getItem(ADMIN_KEY_SESSION), 'test-key');

// clear and reload-from-sessionStorage path
adminKey = null;
assert('falls back to sessionStorage', getAdminKey(), 'test-key');

clearAdminKey();
assert('cleared → null', getAdminKey(), null);

clearAdminKey();
// saveData with no key should skip cloud, only cache
const d2 = getDefaultData();
saveData(d2);
assertTruthy('saveData caches even without key', getCachedData());
    // These come later. When you write them, add:
    // assertTruthy('DEFAULT_DATA has logs', DEFAULT_DATA.logs);
    localStorage.removeItem(STORAGE_KEY);
const fresh = loadData();
assertTruthy('loadData with no cache → default',   fresh.metadata);
assertTruthy('loadData caches default',            getCachedData());

cacheData({ metadata: { userName: 'cached' }, dailyLogs: [] });
const fromCache = loadData();
assert('loadData prefers cache',                   fromCache.metadata.userName, 'cached');

const fixture = {
  metadata: { experimentStartDate: '2026-09-08' },
  dailyLogs: [
    { date: '2026-11-01', sessions: [{ language: 'Korean', durationMinutes: 30 }], mediaConsumed: [{ language: 'Korean', durationMinutes: 20 }], koreanOutput: { intrusions: 2, newWords: 5 }, physiological: { headacheAfterKorean: 3 }, backlog: false },
    { date: '2026-11-02', sessions: [{ language: 'Italian', durationMinutes: 15 }], mediaConsumed: [], koreanOutput: { intrusions: 1, newWords: 3 }, physiological: { headacheAfterKorean: 5 }, backlog: true },
  ],
  languageLevels: {},
};

assert('sumDuration korean = 30', getKoreanStudyHours(fixture), 0.5);
assert('sumMedia korean = 20min → 0.333h', getKoreanMediaHours(fixture).toFixed(2), '0.33');
assert('maintenance = 15min → 0.25h',      getMaintenanceHours(fixture), 0.25);
assert('total new words = 8',              getTotalNewWords(fixture), 8);
assert('backlog = 1',                      getBacklogCount(fixture), 1);
assert('avg headache = 4.0',               getAverageHeadache(fixture), '4.0');
localStorage.removeItem(STORAGE_KEY);
cacheData(getDefaultData());
const result = upsertLog('2026-11-10', { date: '2026-11-10', sessions: [], koreanOutput: { newWords: 0, intrusions: 0 }, physiological: {}, backlog: false });
assertTruthy('upsertLog returns data', result);
assertTruthy('upsertLog added the log', result.dailyLogs.length >= 1);
//section 4
assertTruthy('checkEditMode is defined',     typeof checkEditMode === 'function');
assertTruthy('activateEditMode is defined',  typeof activateEditMode === 'function');
assertTruthy('exitEditMode is defined',      typeof exitEditMode === 'function');
assertTruthy('isEditable is defined',        typeof isEditable === 'function');
assert('isEditable false by default',        isEditable(), false);
assert('ADMIN_KEY_STORAGE matches ADMIN_KEY_SESSION',
  ADMIN_KEY_STORAGE, ADMIN_KEY_SESSION);
    // assertTruthy('STATE is defined after init', STATE);
    // assert('migrate handles empty', typeof migrate({}), 'object');
    // etc.

    //section 5 
    /* ---- SECTION 5: settings ---- */
assertTruthy('openSettings is defined',             typeof openSettings === 'function');
assertTruthy('closeSettings is defined',            typeof closeSettings === 'function');
assertTruthy('renderCustomActivitiesList defined',  typeof renderCustomActivitiesList === 'function');
assertTruthy('removeCustomActivity defined',        typeof removeCustomActivity === 'function');
assertTruthy('saveSettings is defined',             typeof saveSettings === 'function');
assertTruthy('exportData is defined',               typeof exportData === 'function');
assertTruthy('confirmReset is defined',             typeof confirmReset === 'function');
    /* ---- SECTION 6: DOM helpers ---- */
    // When you reach this, add a hidden div and test setText:
    // const d = document.createElement('div'); d.id = 't1'; document.body.appendChild(d);
    // setText('t1', 'hello');
    // assert('setText writes', document.getElementById('t1').textContent, 'hello');
    /* ---- SECTION 6: app shell ---- */
assertTruthy('init is defined',          typeof init === 'function');
assertTruthy('initMode is defined',      typeof initMode === 'function');
assertTruthy('applyMode is defined',     typeof applyMode === 'function');
assertTruthy('toggleMode is defined',    typeof toggleMode === 'function');
assertTruthy('showPage is defined',      typeof showPage === 'function');
assertTruthy('openNotebook is defined',  typeof openNotebook === 'function');
assertTruthy('closeBook is defined',     typeof closeBook === 'function');
assertTruthy('closeNotebook defined',    typeof closeNotebook === 'function');
assertTruthy('goToSection is defined',   typeof goToSection === 'function');
assertTruthy('updateCoverPage defined',  typeof updateCoverPage === 'function');
assertTruthy('updateTOCPage defined',    typeof updateTOCPage === 'function');
assertTruthy('renderTOCLanguages defined', typeof renderTOCLanguages === 'function');
assertTruthy('setText is defined',       typeof setText === 'function');
assertTruthy('setBarWidth is defined',   typeof setBarWidth === 'function');
assertTruthy('getFavouriteWord defined', typeof getFavouriteWord === 'function');
assertTruthy('DATA declared once',       typeof DATA !== 'undefined');

    console.log(`\n===== ${passed} passed, ${failed} failed =====`);
  </script>
</body>
</html>